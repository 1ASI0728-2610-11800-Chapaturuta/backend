# Copia este archivo a  azure.env.local  y rellena.
# azure.env.local NO se commitea (anadelo a .gitignore).

# --- Base de datos (Aiven MySQL). Provider Oracle (MySql.EntityFrameworkCore). SSL obligatorio. ---
# Sintaxis Oracle:  Server=HOST;Port=PORT;Database=defaultdb;User Id=avnadmin;Password=PASS;SslMode=Required
ConnectionStrings__DefaultConnection=Server=HOST;Port=PORT;Database=defaultdb;User Id=avnadmin;Password=PASS;SslMode=Required

# --- JWT: genera uno largo y aleatorio (>=32 chars) ---
TokenSettings__Secret=CAMBIA-esto-por-un-secreto-largo-aleatorio-de-64-chars

# --- Cloudinary (credenciales rotadas) ---
# CloudName es publico (sale en las URLs de imagenes). El ApiSecret es el critico:
# va SOLO en azure.env.local (gitignored), nunca en archivos commiteados.
Cloudinary__CloudName=dclpaghbt
Cloudinary__ApiKey=998885315992822
Cloudinary__ApiSecret=PON-AQUI-EL-API-SECRET-NUEVO

# --- API geografica (opcional, hay fallback local) ---
GeoApi__BaseUrl=https://django-production-0960.up.railway.app/api/districts/

# --- Origen del frontend en Cloudflare Pages (para CORS) ---
FrontendOrigin=https://chapaturuta.pages.dev
