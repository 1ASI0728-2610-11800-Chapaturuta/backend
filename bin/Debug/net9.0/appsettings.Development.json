    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Osrm": {
    "BaseUrl": "http://localhost:5001",
    "TimeoutSeconds": 10,
    "Profile": "driving"
  },

